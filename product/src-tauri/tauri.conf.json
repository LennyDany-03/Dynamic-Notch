{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crest",
  "version": "0.4.1",
  "identifier": "com.lenny.crest",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "notch-widget",
        "title": "",
        "width": 560,
        "height": 420,
        "minWidth": 560,
        "minHeight": 420,
        "maxWidth": 560,
        "maxHeight": 420,
        "y": 0,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": true,
        "focus": false
      },
      {
        "label": "tray-menu",
        "title": "",
        "width": 272,
        "height": 418,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false
      },
      {
        "label": "settings",
        "title": "Crest Settings",
        "width": 720,
        "height": 560,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/LennyDany-03/Dynamic-Notch/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5MjE3ODkyNDNEN0I4OTkKUldTWnVOZERrbmdobVgzSTlCNG1JdWhtRGpXUHAyZFRhVXcyOHZNd2kwSnVnRlNiVUhkOXBCVlYK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    }
  }
}
